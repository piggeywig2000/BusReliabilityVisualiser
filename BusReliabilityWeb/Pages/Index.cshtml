@page
@model IndexModel
@{
    ViewData["Title"] = "Bus Reliability Visualiser";
}

@section Stylesheets {
    <link href="~/lib/leaflet/leaflet.css" rel="stylesheet" />
    <link href="~/css/index.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/lib/leaflet-polylineoffset/leaflet.polylineoffset.js"></script>
    <script>
        window.AppConfig = window.AppConfig || {};
        window.AppConfig.STADIA_API_KEY = @Html.Raw(Json.Serialize(Model.StadiaAPIKey));
    </script>
    <script src="~/js/dataresponse.js" asp-append-version="true"></script>
    <script src="~/js/index.js" asp-append-version="true"></script>
}

<div id="root">
    <div id="dowpick">
        <h3>Day Of Week Selection
            <button class="button-help button-compact">
                ?
                <template>
                    <h3>Day Of Week Selection</h3>
                    <p>Select which days of the week the visualisation should show. Choose between Weekdays, Saturdays, and Sundays.</p>
                    <p>If Saturday were selected for example, the visualisation would show the average bus lateness for every Saturday over the past month.</p>
                </template>
            </button>:
        </h3>
        <select id="dow-select">
            <option value="weekdays" selected>Weekdays (Monday to Friday)</option>
            <option value="saturdays">Saturday</option>
            <option value="sundays">Sunday</option>
        </select>
    </div>
    <div id="map"></div>
    <div id="lines" class="flex-column">
        <h3 class="section-label">Bus Line Selection
            <button class="button-help button-compact">
                ?
                <template>
                    <h3>Bus Line Selection</h3>
                    <p>Select which bus line the visualisation should show. Choose between showing all bus lines at once for a general overview, or show one specific bus line for more detail.</p>
                    <p>If a specific bus line is selected, the visualisation also shows the bus stops. Hover over a bus stop to see its name and lateness value.</p>
                </template>
            </button>
        </h3>
        <div id="lines-list"></div>
    </div>
    <div id="timerange" class="flex-column">
        <h3 class="section-label">Time Of Day Selection
            <button class="button-help button-compact">
                ?
                <template>
                    <h3>Time Of Day Selection</h3>
                    <p>Select which times of day the visualisation should show. The visualisation shows the average lateness for buses across the chosen time window.</p>
                    <p>Drag the edges of the selection box to adjust the size of the window. Drag the middle of the selection box to move the window.</p>
                    <p>The colour of the timeline shows the average bus lateness at specific times of day.</p>
                </template>
            </button>
        </h3>
        <div id="timerange-labels">
            <p>5am</p>
            <p>6am</p>
            <p>7am</p>
            <p>8am</p>
            <p>9am</p>
            <p>10am</p>
            <p>11am</p>
            <p>12pm</p>
            <p>1pm</p>
            <p>2pm</p>
            <p>3pm</p>
            <p>4pm</p>
            <p>5pm</p>
            <p>6pm</p>
            <p>7pm</p>
            <p>8pm</p>
            <p>9pm</p>
            <p>10pm</p>
            <p>11pm</p>
            <p>12am</p>
            <p>1am</p>
            <p>2am</p>
            <p>3am</p>
            <p>4am</p>
        </div>
        <div id="timerange-line">
            <div class="timerange-grab timerange-grab-left" style="left: calc(30.4347% - 1.2rem)"></div>
            <div class="timerange-grab timerange-grab-right" style="left: calc(56.5217% - 1.2rem)"></div>
            <div class="timerange-line-block timerange-line-block-left" hour="5"></div>
            <div class="timerange-line-block" hour="6"></div>
            <div class="timerange-line-block" hour="7"></div>
            <div class="timerange-line-block" hour="8"></div>
            <div class="timerange-line-block" hour="9"></div>
            <div class="timerange-line-block" hour="10"></div>
            <div class="timerange-line-block" hour="11"></div>
            <div class="timerange-line-block" hour="12"></div>
            <div class="timerange-line-block" hour="13"></div>
            <div class="timerange-line-block" hour="14"></div>
            <div class="timerange-line-block" hour="15"></div>
            <div class="timerange-line-block" hour="16"></div>
            <div class="timerange-line-block" hour="17"></div>
            <div class="timerange-line-block" hour="18"></div>
            <div class="timerange-line-block" hour="19"></div>
            <div class="timerange-line-block" hour="20"></div>
            <div class="timerange-line-block" hour="21"></div>
            <div class="timerange-line-block" hour="22"></div>
            <div class="timerange-line-block" hour="23"></div>
            <div class="timerange-line-block" hour="24"></div>
            <div class="timerange-line-block" hour="25"></div>
            <div class="timerange-line-block" hour="26"></div>
            <div class="timerange-line-block timerange-line-block-right" hour="27"></div>
        </div>
    </div>
</div>
<div id="popup-background" class="fullscreen-blocker" style="display: none">
    <div id="popup" class="fullscreen-box">
        <button id="popup-close" class="button-compact" onclick="document.getElementById('popup-background').style.display = 'none'">X</button>
        <div id="popup-content" class="flex-column"></div>
    </div>
</div>
<div id="loading-background" class="fullscreen-blocker">
    <div id="loading" class="fullscreen-box">
        <h1>Loading...</h1>
    </div>
</div>